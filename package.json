  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "capture-presets": "node scripts/capture-presets.mjs",
    "catalog:thorlabs": "bun scripts/catalog/import-thorlabs-lenses.mjs",
    "catalog:thorlabs:exact": "bun scripts/catalog/import-thorlabs-lenses.mjs --with-support-files",
    "catalog:thorlabs-fold-optics": "bun scripts/catalog/import-thorlabs-fold-optics.mjs --with-support-files",
    "catalog:thorlabs-prices": "bun scripts/catalog/enrich-thorlabs-prices.mjs --force",
    "catalog:objective-mechanical": "bun scripts/catalog/build-objective-mechanical-assets.mjs",
    "catalog:lens-mechanical": "bun scripts/catalog/build-objective-mechanical-assets.mjs --component-type sphericalLens --component-type asphericLens --component-type cylindricalLens --component-type achromatDoublet --out-dir public/catalog/mechanical/lenses --batch-size 24 --checkpoint-every 24 --quiet",
    "catalog:fold-optic-mechanical": "bun scripts/catalog/build-objective-mechanical-assets.mjs --component-type mirror --component-type curvedMirror --component-type beamSplitter --component-type polarizingBeamSplitter --component-type dichroic --out-dir public/catalog/mechanical/fold-optics --batch-size 24 --checkpoint-every 24 --quiet",
    "catalog:optical-geometries": "bun scripts/catalog/build-optical-geometry-assets.mjs",
    "catalog:objective-edrawings": "bun scripts/catalog/extract-edrawings-objective-asset.mjs",
    "catalog:objectives-edrawings": "bun scripts/catalog/import-objective-edrawings-assets.mjs",
    "catalog:inspect-edrawings": "bun scripts/catalog/inspect-edrawings-model.mjs",
    "catalog:mechanical-glb": "bun scripts/catalog/convert-mechanical-wrl-to-glb.mjs --apply",
